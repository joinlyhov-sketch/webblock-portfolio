      "put": {
        "tags": [
          "UI: my account"
        ],
        "summary": "Upload or change my profile photo (form field \"file\", PNG or JPG, max 5 MB)",
        "operationId": "changePhoto",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
