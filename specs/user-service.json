          "UI: my account"
        ],
        "summary": "My profile (creates the account on the first call)",
        "operationId": "get",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "UI: my account"
        ],
        "summary": "Change my full name",
        "operationId": "update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          }
        }
      }
    },
    "/api/user/v1/ui/me/password": {
      "put": {
        "tags": [
          "UI: my account"
        ],
        "summary": "Change or set my password; signs me out everywhere",
        "operationId": "changePassword",
